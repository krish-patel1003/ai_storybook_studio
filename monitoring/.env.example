# Copy to .env and fill in. Used by docker-compose for Grafana + Alertmanager.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-strong

# Slack incoming-webhook URL for alerts (see alertmanager/alertmanager.yml).
# Alertmanager does NOT expand env vars in its config file — paste this URL
# directly into alertmanager.yml before starting, or run it through envsubst.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXXX/XXXX/XXXX
